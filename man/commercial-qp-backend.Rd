\item \eqn{P = A^T A}{P = A'A}, \eqn{q = -A^T b}{q = -A'b};
\item \code{norm = 2}: \eqn{P \mathrel{+}= \alpha I} for
\code{smoothness_order = 0}, else
\eqn{P \mathrel{+}= \alpha\,w\,L^T L}{P += alpha*w*L'L} with \eqn{L} the
